# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAAA...

# Comma-separated Telegram user IDs of administrators
# (find yours by messaging @userinfobot)
ADMIN_IDS=11111111,22222222

# --- Mini App (in-Telegram UI) ---
# Public HTTPS URL of the app (Telegram requires HTTPS). Point a reverse
# proxy / Cloudflare Tunnel / ngrok at the local port below.
# Leave unset to run the bot chat-only.
WEBAPP_URL=https://bppm.example.com
WEBAPP_PORT=8080

# Optional overrides
#DB_PATH=/var/lib/bppm/bppm.sqlite3
#PHOTO_DIR=/var/lib/bppm/photos
#TIMEZONE=Asia/Kuching
#DAILY_DIGEST_HOUR=18
